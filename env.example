# SIEM Configuration
# Set this environment variable to override the API key in config.yaml
SIEM_API_KEY=your_siem_api_key_here

# SOAR Configuration
# Set this environment variable to override the API key in config.yaml
SOAR_API_KEY=your_soar_api_key_here

# Observability
# Toggle Prometheus metrics for the data pipeline (1 to enable)
ENABLE_PIPELINE_METRICS=0
# Port for the metrics HTTP server
METRICS_PORT=9000

